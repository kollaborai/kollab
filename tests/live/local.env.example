# Copy to tests/live/local.env (untracked, git-ignored) and fill in your real hosts. m1/env.sh sources it, so every
# live proof (m1 to m4, guided, story5, story7) picks the values up. Variables you leave out keep the placeholder
# defaults below.

# Absolute path of this checkout on the machine that drives the proofs.
M1_REPO=$HOME/dev/kollab
# ssh alias of the remote host that runs the second device (key auth, no password prompt).
M1_HOST=server
# ssh alias of the public edge host that fronts the self-hosted directory (m4 only).
M4_EDGE_HOST=edge
# ssh alias of the host that hops to the edge; the edge accepts ssh only from there (m4 only).
M4_EDGE_VIA=server
# user@address the hop host uses to reach the edge over the private network (m4 only).
M4_EDGE_TARGET=deploy@edge.example
# ssh port of the edge on that hop (m4 only).
M4_EDGE_SSH_PORT=22
# Private-network address of the edge; serve_up.sh trusts it as the proxy when the old relay config names none (m4 only).
M4_EDGE_WG_IP=10.0.0.2
