{
  "name": "voice classifier screen",
  "description": "/voice classifier opens the two-pane decision screen; Esc returns to the prompt",
  "config": {
    "command": "sh -c 'R=$(pwd); cd \"$(mktemp -d)\" && KOLLAB_NO_HUB=1 exec \"$R/.venv/bin/python\" \"$R/main.py\" --no-daemon'",
    "app_init_sleep": 3,
    "show_captures": false
  },
  "steps": [
    {
      "action": "start_app"
    },
    {
      "action": "wait_for",
      "pattern": "mic off",
      "timeout": 30
    },
    {
      "action": "section",
      "title": "Open the screen"
    },
    {
      "action": "slash_command",
      "command": "voice",
      "subcommand": "classifier"
    },
    {
      "action": "wait_for",
      "pattern": "Voice Events 0",
      "timeout": 8
    },
    {
      "action": "capture"
    },
    {
      "action": "assert_contains",
      "pattern": "No classifier calls yet"
    },
    {
      "action": "assert_contains",
      "pattern": "Voice is off. /voice on, then speak."
    },
    {
      "action": "assert_contains",
      "pattern": "Classifier: "
    },
    {
      "action": "section",
      "title": "Esc closes it"
    },
    {
      "action": "escape"
    },
    {
      "action": "wait_for",
      "pattern": "❯ █",
      "timeout": 6
    },
    {
      "action": "capture"
    },
    {
      "action": "assert_not_contains",
      "pattern": "Voice Events"
    }
  ]
}
