{
  "name": "plugin-cli",
  "description": "Install, update and remove a local Git-backed hello plugin with explicit interactive approval in an isolated HOME.",
  "config": {
    "command": "bash --noprofile --norc",
    "app_init_sleep": 1,
    "term_width": 140,
    "term_height": 40,
    "key_delay": 0.2
  },
  "steps": [
    {
      "action": "shell",
      "description": "create a local repository and route a fake HTTPS URL to it without network access",
      "command": "set -e; cp -R bundles/plugins/hello \"$HOME/source\"; git -C \"$HOME/source\" init -q; git -C \"$HOME/source\" config user.name 'Plugin Test'; git -C \"$HOME/source\" config user.email 'plugin-test@example.invalid'; git -C \"$HOME/source\" add .; git -C \"$HOME/source\" commit -qm initial; git config --global protocol.file.allow always; git config --global url.\"file://$HOME/source\".insteadOf https://example.invalid/hello.git; echo fixture-ready",
      "assert_contains": "fixture-ready"
    },
    {"action": "start_app"},
    {"action": "type", "text": "python3 main.py plugin add https://example.invalid/hello.git", "delay": 0.01},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Install this exact version", "timeout": 25},
    {"action": "type", "text": "yes"},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Installed hello", "timeout": 25},
    {"action": "type", "text": "python3 main.py plugin disable hello", "delay": 0.01},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Confirm", "timeout": 25},
    {"action": "type", "text": "yes"},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Disabled hello", "timeout": 25},
    {"action": "type", "text": "python3 main.py plugin enable hello", "delay": 0.01},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Confirm", "timeout": 25},
    {"action": "type", "text": "yes"},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Enabled hello", "timeout": 25},
    {"action": "type", "text": "python3 main.py plugin list", "delay": 0.01},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "hello  0\\.1\\.0  enabled", "timeout": 25},
    {
      "action": "shell",
      "description": "configure an offline test profile for the interactive terminal",
      "command": "mkdir -p \"$HOME/.kollab\"; printf '%s' '{\"kollabor\":{\"llm\":{\"active_profile\":\"openai-test\",\"profiles\":{\"openai-test\":{\"provider\":\"openai\",\"model\":\"gpt-5.5\",\"base_url\":\"https://api.openai.com/v1\",\"api_key\":\"sk-test-dummy\",\"supports_tools\":false}}}},\"plugins\":{\"hub\":{\"enabled\":false}}}' > \"$HOME/.kollab/config.json\"; echo profile-ready",
      "assert_contains": "profile-ready"
    },
    {"action": "start_app", "command": "python3 main.py --no-daemon; echo KOLLAB-EXITED", "sleep": 12},
    {"action": "capture", "show": true},
    {"action": "type", "text": "/hello"},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Hello from the plugin!", "timeout": 25},
    {"action": "type", "text": "/config"},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "System Configuration", "timeout": 20},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "send_keys", "keys": "Tab"},
    {"action": "capture", "show": true},
    {"action": "wait_for", "pattern": "Greeting", "timeout": 10},
    {"action": "send_keys", "keys": "Space"},
    {"action": "capture", "show": true},
    {"action": "send_keys", "keys": "C-s"},
    {"action": "wait_for", "pattern": "Save to:", "timeout": 10},
    {"action": "type", "text": "g"},
    {"action": "sleep", "seconds": 3},
    {"action": "capture", "show": true},
    {
      "action": "shell",
      "description": "verify the terminal stopped the service",
      "command": "python3 -c 'import json,os,pathlib; p=pathlib.Path(os.environ[\"HOME\"])/\".kollab/plugin-data/hello/run/hello.state\"; assert json.loads(p.read_text())[\"desired\"] == \"stopped\"; print(\"service-stopped\")'",
      "assert_contains": "service-stopped"
    },
    {"action": "send_keys", "keys": "Space"},
    {"action": "capture", "show": true},
    {"action": "send_keys", "keys": "C-s"},
    {"action": "wait_for", "pattern": "Save to:", "timeout": 10},
    {"action": "type", "text": "g"},
    {"action": "sleep", "seconds": 3},
    {
      "action": "shell",
      "description": "verify the terminal started the service",
      "command": "python3 -c 'import json,os,pathlib; p=pathlib.Path(os.environ[\"HOME\"])/\".kollab/plugin-data/hello/run/hello.state\"; state=json.loads(p.read_text()); print(state); assert state[\"desired\"] == \"running\" and state[\"status\"] == \"running\"; print(\"service-started\")'",
      "assert_contains": "service-started"
    },
    {"action": "send_keys", "keys": "Down"},
    {"action": "type", "text": "test-greeting"},
    {"action": "send_keys", "keys": "C-s"},
    {"action": "wait_for", "pattern": "Save to:", "timeout": 10},
    {"action": "type", "text": "g"},
    {"action": "sleep", "seconds": 2},
    {
      "action": "shell",
      "description": "verify the terminal saved plugin settings",
      "command": "python3 -c 'import json,os,pathlib; p=pathlib.Path(os.environ[\"HOME\"])/\".kollab/plugin-data/hello/values.json\"; assert json.loads(p.read_text())[\"greeting\"] == \"test-greeting\"; print(\"setting-saved\")'",
      "assert_contains": "setting-saved"
    },
    {"action": "send_keys", "keys": "Escape"},
    {"action": "type", "text": "/quit"},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "KOLLAB-EXITED", "timeout": 25},
    {"action": "type", "text": "python3 main.py plugin dev \"$HOME/source\"", "delay": 0.01},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Continue", "timeout": 25},
    {"action": "type", "text": "yes"},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Attached hello@dev", "timeout": 25},
    {"action": "type", "text": "python3 main.py plugin dev off hello", "delay": 0.01},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Continue", "timeout": 25},
    {"action": "type", "text": "yes"},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Detached hello@dev", "timeout": 25},
    {
      "action": "shell",
      "description": "advance the source repository",
      "command": "printf '\\n# changed\\n' >> \"$HOME/source/python/hello.py\"; git -C \"$HOME/source\" add python/hello.py; git -C \"$HOME/source\" commit -qm update; echo update-ready",
      "assert_contains": "update-ready"
    },
    {"action": "type", "text": "python3 main.py plugin update hello", "delay": 0.01},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Update this plugin", "timeout": 25},
    {"action": "type", "text": "yes"},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Updated hello", "timeout": 25},
    {"action": "type", "text": "python3 main.py plugin remove hello", "delay": 0.01},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Remove this plugin", "timeout": 25},
    {"action": "type", "text": "yes"},
    {"action": "enter"},
    {"action": "wait_for", "pattern": "Removed hello", "timeout": 25},
    {"action": "type", "text": "exit"},
    {"action": "enter"}
  ]
}
