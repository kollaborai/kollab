{
  "name": "phase-4-5-restart-local",
  "description": "Verify /new clears the conversation via state.restart_session (phase 4.5 step 7); /restart no longer clears it (#968)",
  "config": {
    "command": "python main.py --no-daemon",
    "app_init_sleep": 3,
    "show_captures": false,
    "term_width": 120,
    "term_height": 40
  },
  "steps": [
    {
      "action": "start_app"
    },
    {
      "action": "wait_for",
      "pattern": "\u276f",
      "timeout": 20,
      "description": "app ready at the input prompt"
    },
    {
      "action": "capture"
    },
    {
      "action": "section",
      "title": "/new with no messages"
    },
    {
      "action": "slash_command",
      "command": "new"
    },
    {
      "action": "sleep",
      "seconds": 2
    },
    {
      "action": "capture"
    },
    {
      "action": "assert_contains",
      "pattern": "Session cleared|Cleared",
      "description": "/new success message from state_service"
    },
    {
      "action": "assert_contains",
      "pattern": "Agent:",
      "description": "/new shows agent name from snapshot"
    }
  ]
}
