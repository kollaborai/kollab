<mxfile host="drawio">
  <diagram id="wake" name="Hub Wake Gaps">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Remote Hub Message: Why The Agent Didn't Wake&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- lanes -->
        <mxCell id="laneS" value="Sender: koordinator@home-server" style="swimlane;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="420" height="760" as="geometry" />
        </mxCell>
        <mxCell id="laneR" value="Receiver: koordinator@laptop (Mac)" style="swimlane;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="60" width="860" height="760" as="geometry" />
        </mxCell>

        <!-- sender -->
        <mxCell id="s1" value="Model emits &lt;b&gt;hub_msg&lt;/b&gt;&lt;br&gt;&quot;...Compose st&lt;u&gt;ack&lt;/u&gt;s also report exited...&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneS">
          <mxGeometry x="60" y="50" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Auto-wait check&lt;/b&gt;&lt;br&gt;&quot;standing by / waiting for&quot; anywhere&lt;br&gt;ends the sender's turn&lt;br&gt;&lt;i&gt;GAP 3 (open): long msgs get cut off&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="laneS">
          <mxGeometry x="60" y="150" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Outgoing classification&lt;/b&gt;&lt;br&gt;ack? report? assignment?&lt;br&gt;&lt;i&gt;GAP 2 (fixed): &quot;in&lt;u&gt;complete&lt;/u&gt;&quot; tagged task_report&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="laneS">
          <mxGeometry x="60" y="270" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Relay send (open trust)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;relay_agent._rpc_send&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneS">
          <mxGeometry x="60" y="390" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Waits on the thread for&lt;br&gt;the receiver's &lt;b&gt;turn_end&lt;/b&gt; frame" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneS">
          <mxGeometry x="60" y="600" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- receiver -->
        <mxCell id="r1" value="Relay queue&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;_deliver_open_message&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneR">
          <mxGeometry x="40" y="390" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Display box + inject&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;_on_message_received&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneR">
          <mxGeometry x="320" y="390" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;Ack only?&lt;/b&gt;&lt;br&gt;_decide_hub_wake" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneR">
          <mxGeometry x="600" y="360" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r3note" value="&lt;b&gt;GAP 1 (fixed) - the bug you hit&lt;/b&gt;&lt;br&gt;substring match: &quot;ack&quot; in &quot;st&lt;u&gt;ack&lt;/u&gt;s&quot;&lt;br&gt;now: whole words + max 25 words" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="laneR">
          <mxGeometry x="560" y="200" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;observe&lt;/b&gt;&lt;br&gt;message shown, model never runs&lt;br&gt;turn_end sent at once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="laneR">
          <mxGeometry x="40" y="600" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="&lt;b&gt;wake&lt;/b&gt;&lt;br&gt;TRIGGER_LLM_CONTINUE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneR">
          <mxGeometry x="600" y="560" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="Model turn runs, replies via hub_msg,&lt;br&gt;then turn_end" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneR">
          <mxGeometry x="580" y="670" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="network" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="s4" target="r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="html=1;dashed=1;endArrow=none;strokeColor=#b85450;" edge="1" parent="1" source="r3note" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="yes (old bug path)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="530" /><mxPoint x="670" y="530" /></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="no (fixed path)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="r3" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="r5" target="r6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="turn_end (instant, no reply)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="r4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- legend -->
        <mxCell id="lg1" value="fixed" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="90" height="30" as="geometry" /></mxCell>
        <mxCell id="lg2" value="open, your call" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="140" y="840" width="120" height="30" as="geometry" /></mxCell>
        <mxCell id="lg3" value="working path" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="270" y="840" width="110" height="30" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
