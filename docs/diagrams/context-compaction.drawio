<mxfile host="drawio"><diagram id="p1" name="1 Trigger and threshold"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1900" pageHeight="1400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Context compaction: when it fires  (plugins/context_compaction_plugin.py, _on_llm_turn_complete :869, _should_compact :730, _get_token_threshold :702)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="40" as="geometry"/></mxCell><mxCell id="c2" value="LLM turn finishes&lt;br&gt;(response parsed, tools executed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="320" height="60" as="geometry"/></mxCell><mxCell id="c3" value="LLM_REQUEST_POST hook&lt;br&gt;_on_llm_turn_complete()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="500" y="175" width="320" height="60" as="geometry"/></mxCell><mxCell id="c4" value="enabled AND not disabled_for_session&lt;br&gt;AND no compaction already running?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="275" width="400" height="110" as="geometry"/></mxCell><mxCell id="c5" value="return, nothing happens" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="300" width="240" height="60" as="geometry"/></mxCell><mxCell id="c6" value="GATE 1: prompt tokens ≥ threshold?&lt;br&gt;max( API-reported last request , history chars / 3 )" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="430" width="440" height="120" as="geometry"/></mxCell><mxCell id="c7" value="no compaction this turn" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="460" width="240" height="60" as="geometry"/></mxCell><mxCell id="c8" value="GATE 2: ≥ 6 human turns?&lt;br&gt;(min_human_turns, hub msgs not counted)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="595" width="400" height="110" as="geometry"/></mxCell><mxCell id="c9" value="too early, skip" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="620" width="240" height="60" as="geometry"/></mxCell><mxCell id="c10" value="Coordination in flight?&lt;br&gt;queued hub HUD msgs or pending ledger replies" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="750" width="440" height="120" as="geometry"/></mxCell><mxCell id="c11" value="DEFER one turn&lt;br&gt;retry at next turn-complete&lt;br&gt;(coordination state never summarized mid-flight)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="745" width="300" height="90" as="geometry"/></mxCell><mxCell id="c12" value="asyncio.create_task(_run_compaction)&lt;br&gt;BACKGROUND, in_progress = True&lt;br&gt;turn loop is NOT blocked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="925" width="360" height="90" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;dashed=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="c11" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="EVERY turn, regardless of gates: budget HUD&lt;br&gt;every 5th turn (budget_hud_every_n_turns) queue_agent_hud()&lt;br&gt;the MODEL sees one line: &#x27;used K / window K (pct%)&#x27;&lt;br&gt;≥70%: &#x27;getting full, prefer grep over whole-file reads&#x27;&lt;br&gt;≥85%: &#x27;nearly full, wrap up or /compact soon&#x27;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="175" width="340" height="120" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c3" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="CURATOR PROMPT (context_service), model decides&lt;br&gt;when ledger ≥ 300KB, items pending, ≥ 2 turns since last:&lt;br&gt;injected list of heavy items (≥ 8KB tool results / file reads)&lt;br&gt;MODEL answers &amp;lt;curate id=ctx-N decision=keep|summary&amp;gt;&lt;br&gt;or &amp;lt;evict&amp;gt;, or ignores it (page 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="340" height="130" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="1" source="c3" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="The LLM sees ONLY these two things before compaction: budget HUD + curator prompt.&lt;br&gt;The check runs AFTER a turn, the swap happens BEFORE the next request (page 2)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="340" height="90" as="geometry"/></mxCell><mxCell id="c29" value="How the threshold is determined  (_get_token_threshold)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1320" y="80" width="560" height="40" as="geometry"/></mxCell><mxCell id="c30" value="_get_token_threshold()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1400" y="140" width="300" height="50" as="geometry"/></mxCell><mxCell id="c31" value="token_threshold_k &amp;gt; 0&lt;br&gt;in config?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1380" y="230" width="340" height="100" as="geometry"/></mxCell><mxCell id="c32" value="threshold = k × 1000&lt;br&gt;[manual]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1760" y="245" width="160" height="70" as="geometry"/></mxCell><mxCell id="c33" value="context window&lt;br&gt;resolved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1380" y="380" width="340" height="100" as="geometry"/></mxCell><mxCell id="c34" value="100K hard fallback&lt;br&gt;[fallback]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1760" y="395" width="160" height="70" as="geometry"/></mxCell><mxCell id="c35" value="threshold = min( window × ratio , 272K cap )&lt;br&gt;ratio = compaction_ratio 0.75, clamped 0.50–0.95&lt;br&gt;[auto]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="540" width="380" height="100" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c31" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c33" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="Window resolution order:&lt;br&gt;1 live provider config.context_window (per-profile override wins)&lt;br&gt;2 models.json, longest-prefix match on model id&lt;br&gt;3 provider_defaults (openai 128K, anthropic 200K, gemini 1M)&lt;br&gt;&lt;br&gt;Example gpt-6-luna: 1.05M × 0.75 = 787K → capped to 272K&lt;br&gt;Example claude-haiku-4-5: 200K × 0.75 = 150K (below cap)&lt;br&gt;&lt;br&gt;272K cap = OpenAI long-context surcharge line (2x in / 1.5x out)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="690" width="520" height="200" as="geometry"/></mxCell><mxCell id="c42" value="threshold from" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2 Background run and swap"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1900" pageHeight="1500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Compaction run: background summarize, then atomic swap at the next request" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="40" as="geometry"/></mxCell><mxCell id="laneF" value="FOREGROUND  (main turn loop, never blocked)" style="swimlane;html=1;startSize=28;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="600" height="1380" as="geometry"/></mxCell><mxCell id="laneB" value="BACKGROUND  (_run_compaction task, plugins/context_compaction_plugin.py:1284)" style="swimlane;html=1;startSize=28;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="700" height="1380" as="geometry"/></mxCell><mxCell id="c2" value="Turn N completes&lt;br&gt;POST hook: gates pass, task spawned (page 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="440" height="70" as="geometry"/></mxCell><mxCell id="c3" value="Turn N+1, N+2 … keep running normally&lt;br&gt;LLM sees the FULL, UNCOMPACTED history.&lt;br&gt;Nothing about compaction is visible to it.&lt;br&gt;Only signals: budget HUD line + curator prompt&lt;br&gt;(page 1, page 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="230" width="440" height="110" as="geometry"/></mxCell><mxCell id="c4" value="Next request goes out:&lt;br&gt;LLM_REQUEST_PRE hook&lt;br&gt;_apply_pending_compaction()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="120" y="400" width="440" height="80" as="geometry"/></mxCell><mxCell id="c5" value="staged compaction&lt;br&gt;ready?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="200" y="530" width="280" height="100" as="geometry"/></mxCell><mxCell id="c6" value="send request as-is&lt;br&gt;(full history, task still running)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="545" width="200" height="70" as="geometry"/></mxCell><mxCell id="c7" value="still valid?&lt;br&gt;same session AND history&lt;br&gt;not reset (len ≥ pre_len)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="170" y="690" width="340" height="120" as="geometry"/></mxCell><mxCell id="c8" value="DISCARD staged compaction&lt;br&gt;(session changed or history reset)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="540" y="710" width="200" height="80" as="geometry"/></mxCell><mxCell id="c9" value="ATOMIC SWAP&lt;br&gt;history[:] = compacted + messages added&lt;br&gt;while the task was running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="870" width="440" height="90" as="geometry"/></mxCell><mxCell id="c10" value="display &#x27;compacted N → M msgs&#x27; event&lt;br&gt;sync conversation_manager context window&lt;br&gt;clear staged state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="120" y="1000" width="440" height="80" as="geometry"/></mxCell><mxCell id="c11" value="THIS request is the first the LLM sees&lt;br&gt;compacted: system + summary + preserved tasks&lt;br&gt;+ recent messages (page 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="1120" width="440" height="90" as="geometry"/></mxCell><mxCell id="c12" value="1 SNAPSHOT history copy&lt;br&gt;remember snapshot length + session id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="110" width="500" height="70" as="geometry"/></mxCell><mxCell id="c13" value="2 SPLIT POINT&lt;br&gt;keep_recent = max(8, window // 100K)&lt;br&gt;walks back so an assistant tool_calls message&lt;br&gt;is never split from its tool results (API 400s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="210" width="500" height="100" as="geometry"/></mxCell><mxCell id="c14" value="3 VAULT SNAPSHOT&lt;br&gt;last 20 old msgs appended to hub vault stream.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="340" width="500" height="70" as="geometry"/></mxCell><mxCell id="c15" value="4 PARTITION old messages&lt;br&gt;ledger-tracked heavy items: apply the MODEL&#x27;s curation&lt;br&gt;(keep verbatim · its own summary · evicted stub · pending → elided marker)&lt;br&gt;hub task msgs kept VERBATIM · coordination lines VERBATIM&lt;br&gt;only the rest goes to the summarizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="860" y="440" width="500" height="110" as="geometry"/></mxCell><mxCell id="c16" value="5 SUMMARIZER LLM CALL (separate request)&lt;br&gt;profile = summarization_profile, else active profile&lt;br&gt;input = untracked OLD messages only, max_summary_tokens 2000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="575" width="500" height="100" as="geometry"/></mxCell><mxCell id="c17" value="summary ≥ 100 chars?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="960" y="705" width="300" height="90" as="geometry"/></mxCell><mxCell id="c18" value="FAILURE: failures++&lt;br&gt;3 in a row → compaction disabled for session&lt;br&gt;history untouched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1290" y="705" width="150" height="110" as="geometry"/></mxCell><mxCell id="c19" value="6 BUILD compacted history&lt;br&gt;+ write checkpoint file (full pre-compaction history kept on disk)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="845" width="500" height="80" as="geometry"/></mxCell><mxCell id="c20" value="7 STAGE&lt;br&gt;_pending_compaction = compacted · round++&lt;br&gt;log event · in_progress = False" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="955" width="500" height="90" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="spawn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="picked up at next request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c20" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="Answers&lt;br&gt;• LLM sees nothing before the swap except the budget HUD line and the curator prompt (where IT picks keep / summary for heavy items).&lt;br&gt;• Summarizing runs in the background; the foreground never waits for it.&lt;br&gt;• Staged result is applied only at the next LLM_REQUEST_PRE, one atomic slice assignment.&lt;br&gt;• Messages that arrive mid-run are kept (appended after the compacted block).&lt;br&gt;• Cost: one extra LLM call per compaction (the summarizer)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="110" width="380" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 History before and after"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="History layout: before vs after compaction  (_build_compacted_history :1672)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="c2" value="BEFORE (snapshot)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="100" y="70" width="400" height="30" as="geometry"/></mxCell><mxCell id="c3" value="AFTER (swapped in)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="400" height="30" as="geometry"/></mxCell><mxCell id="c4" value="system prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="380" height="60" as="geometry"/></mxCell><mxCell id="c5" value="OLD messages: chat, tool calls, tool results&lt;br&gt;(everything before the split point)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="380" height="130" as="geometry"/></mxCell><mxCell id="c6" value="ledger-tracked heavy items (ctx_id)&lt;br&gt;file reads / tool results ≥ 8KB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="380" height="60" as="geometry"/></mxCell><mxCell id="c7" value="hub task messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="380" height="60" as="geometry"/></mxCell><mxCell id="c8" value="RECENT messages (keep_recent, default 8+)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="380" height="90" as="geometry"/></mxCell><mxCell id="c9" value="system prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="380" height="60" as="geometry"/></mxCell><mxCell id="c10" value="SUMMARY message&lt;br&gt;= coordination block verbatim (hub lines)&lt;br&gt;+ LLM summary (≤ 2000 tokens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="190" width="380" height="100" as="geometry"/></mxCell><mxCell id="c11" value="ledger-handled: model&#x27;s curation applied&lt;br&gt;keep verbatim · its own summary · elided marker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="820" y="310" width="380" height="60" as="geometry"/></mxCell><mxCell id="c12" value="preserved hub tasks, VERBATIM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="820" y="390" width="380" height="60" as="geometry"/></mxCell><mxCell id="c13" value="synthetic task reminder (active tasks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="470" width="380" height="60" as="geometry"/></mxCell><mxCell id="c14" value="RECENT messages, intact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="550" width="380" height="90" as="geometry"/></mxCell><mxCell id="c15" value="messages added while the task ran" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="660" width="380" height="60" as="geometry"/></mxCell><mxCell id="c16" value="kept" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="summarized" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="ledger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="verbatim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="kept" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="Safety nets&lt;br&gt;• Full pre-compaction history written to a checkpoint file before the swap&lt;br&gt;• Last 20 old msgs also appended to the hub vault stream&lt;br&gt;• Conversation JSONL logging is untouched, so nothing is lost on disk&lt;br&gt;• compaction_round increments each time; the summary carries pre/post message counts" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="640" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4 Model-driven curation"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1900" pageHeight="1300"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Who decides what to keep: the MODEL curates heavy items  (context_service ledger, packages/kollabor-ai/.../context_service/service.py)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Tool result or file read ≥ 8KB&lt;br&gt;(heavy_threshold_kb)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="80" width="340" height="70" as="geometry"/></mxCell><mxCell id="c3" value="INGEST as ledger entry ctx-N&lt;br&gt;decision = pending · message tagged with ctx_ids&lt;br&gt;re-read of same hash → &#x27;already in context&#x27; marker (dedup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="190" width="420" height="90" as="geometry"/></mxCell><mxCell id="c4" value="ledger total ≥ 300KB&lt;br&gt;AND items pending&lt;br&gt;AND ≥ 2 turns since last prompt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="320" width="420" height="130" as="geometry"/></mxCell><mxCell id="c5" value="no prompt this turn&lt;br&gt;(entries stay pending)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="355" width="240" height="60" as="geometry"/></mxCell><mxCell id="c6" value="CURATOR PROMPT injected to the model&lt;br&gt;lists pending + already-decided items with size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="500" y="500" width="420" height="80" as="geometry"/></mxCell><mxCell id="c7" value="MODEL replies, per item:&lt;br&gt;&amp;lt;curate id=ctx-N decision=keep&amp;gt; reason &amp;lt;/curate&amp;gt;&lt;br&gt;&amp;lt;curate id=ctx-N decision=summary&amp;gt; its own compressed text &amp;lt;/curate&amp;gt;&lt;br&gt;&amp;lt;evict id=ctx-N&amp;gt; drop now (breaks cache) &amp;lt;/evict&amp;gt;&lt;br&gt;or ignores it. Can also curate any turn unprompted; &amp;lt;context/&amp;gt; shows the ledger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="625" width="540" height="130" as="geometry"/></mxCell><mxCell id="c8" value="COMPACTION (page 2, step 4) applies each decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="800" width="420" height="60" as="geometry"/></mxCell><mxCell id="c9" value="keep&lt;br&gt;message stays VERBATIM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="920" width="260" height="70" as="geometry"/></mxCell><mxCell id="c10" value="summary&lt;br&gt;MODEL&#x27;s text replaces the result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="920" width="260" height="70" as="geometry"/></mxCell><mxCell id="c11" value="evicted&lt;br&gt;already-rewritten stub stays" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="920" width="260" height="70" as="geometry"/></mxCell><mxCell id="c12" value="pending (unmarked)&lt;br&gt;elided: &#x27;[ctx-N kind label, NKB, elided]&#x27;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="980" y="920" width="300" height="70" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;dashed=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="c5" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="Everything NOT ledger-tracked (chat turns, small tool results) is summarized by the separate summarizer LLM, the model does not choose those.&lt;br&gt;Multi-entry messages take the most conservative decision: keep &amp;gt; summary &amp;gt; pending &amp;gt; evicted.&lt;br&gt;Config: plugins.context_service heavy_threshold_kb 8 · curate_threshold_kb 300 · curator_throttle_turns 2.&lt;br&gt;The curator prompt text says unmarked items default to auto-summary, but the compaction code elides them with a size marker." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1050" width="1200" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>