<mxfile host="drawio"><diagram id="p0" name="1 Turn Lifecycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1900" pageHeight="2100"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Tool-call turn lifecycle  (QueueProcessor._execute_llm_turn_inner, queue_processor.py:822-1750)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="in" value="TURN STARTS&lt;br&gt;from any driver (see page 2): user batch / continue_conversation / hub wake / goal attempt&lt;br&gt;_turn_lock serializes; mark_progress() heartbeat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="400" height="80" as="geometry"/></mxCell><mxCell id="pre" value="LLM_REQUEST_PRE hooks&lt;br&gt;can cancel turn, or WITHHOLD tools (relay event turns answer in text)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="640" y="185" width="320" height="70" as="geometry"/></mxCell><mxCell id="call" value="streaming_handler.call_llm(history + tool schemas)&lt;br&gt;-&gt; provider transport (page 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="320" height="70" as="geometry"/></mxCell><mxCell id="len" value="stop_reason == &quot;length&quot;&lt;br&gt;and continuations &lt; 3 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="610" y="390" width="380" height="100" as="geometry"/></mxCell><mxCell id="lenA" value="Inline auto-continue (max 3):&lt;br&gt;append partial assistant + &quot;[system] continue exactly where you left off&quot;,&lt;br&gt;re-call, merge, then DELETE the fragment msgs from history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="390" width="300" height="100" as="geometry"/></mxCell><mxCell id="par" value="Parse (unified pipeline, ALWAYS both):&lt;br&gt;1 native tool_calls from API  2 XML/plugin tags from text&lt;br&gt;3 merge native + XML thinking -&gt; LLM_THINKING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="525" width="320" height="90" as="geometry"/></mxCell><mxCell id="tc" value="turn_completed = parser.turn_completed (no tools ran)&lt;br&gt;native tools present -&gt; turn_completed = False&lt;br&gt;(question gate removed 2026-10-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="650" width="320" height="90" as="geometry"/></mxCell><mxCell id="lr" value="LLM_RESPONSE hook (hub / plugins)&lt;br&gt;force_continue -&gt; turn_completed=False&lt;br&gt;turn_complete -&gt; True   suppress_display" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="640" y="775" width="320" height="80" as="geometry"/></mxCell><mxCell id="nat" value="Step 6: native tools&lt;br&gt;execute_tool_calls() batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="1030" width="260" height="60" as="geometry"/></mxCell><mxCell id="xml" value="Step 7: XML / plugin tools&lt;br&gt;sequential, each displayed incrementally;&lt;br&gt;cancel mid-batch -&gt; remaining = &quot;Cancelled by user&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="1030" width="300" height="70" as="geometry"/></mxCell><mxCell id="perm" value="tool_executor.execute_tool: TOOL_CALL_PRE&lt;br&gt;permission hook @ SECURITY(900): approve once / session / project / deny" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="390" y="1140" width="330" height="70" as="geometry"/></mxCell><mxCell id="den" value="DENIED -&gt; failed result&lt;br&gt;metadata.permission_denied&lt;br&gt;(the model must see it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="350" y="1260" width="250" height="70" as="geometry"/></mxCell><mxCell id="run" value="RUN: terminal 90s, MCP 180s timeouts,&lt;br&gt;tool_executing=True (watchdog guard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="1260" width="280" height="70" as="geometry"/></mxCell><mxCell id="pack" value="Result packing: _cap_tool_output, in-flight batch budget&lt;br&gt;(floor 2000 chars, _bounded_omission -&gt; one-line spill pointer),&lt;br&gt;Bridge relay, log + append to history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="580" y="1380" width="440" height="80" as="geometry"/></mxCell><mxCell id="gev" value="on_tool_batch -&gt; goal evidence rows&lt;br&gt;error signature saved (circuit breaker input)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1060" y="1380" width="330" height="70" as="geometry"/></mxCell><mxCell id="fu" value="Step 10: _tool_results_requiring_followup&lt;br&gt;any result AND NOT (all ok AND some end_turn)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="550" y="1490" width="500" height="110" as="geometry"/></mxCell><mxCell id="res" value="turn_completed = False&lt;br&gt;=&gt; driver calls the LLM AGAIN&lt;br&gt;(tool results go back as tool_result / function_call_output)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="1650" width="320" height="90" as="geometry"/></mxCell><mxCell id="end" value="turn_completed = True&lt;br&gt;(hub_msg/hub_reply wait=&quot;true&quot; + all ok;&lt;br&gt;or text-only reply, no tools)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="1650" width="320" height="90" as="geometry"/></mxCell><mxCell id="pub" value="publish_semantic(&quot;turn_complete&quot;, tokens, tool_calls, stop_reason)&lt;br&gt;only when turn_completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="1780" width="320" height="70" as="geometry"/></mxCell><mxCell id="ex1" value="CancelledError (ESC)&lt;br&gt;-&gt; clear UI, turn_completed=True" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1110" y="1640" width="260" height="60" as="geometry"/></mxCell><mxCell id="ex2" value="Exception&lt;br&gt;-&gt; display error, last_turn_error, turn_completed=True&lt;br&gt;(LOOP2 reads last_turn_error; hub chain just breaks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1110" y="1740" width="300" height="90" as="geometry"/></mxCell><mxCell id="nt" value="No tools at all (text only):&lt;br&gt;skip 6/7, parser says turn_completed=True" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="890" width="260" height="70" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="in" target="pre"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="pre" target="call"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="call" target="len"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="len" target="par"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="par" target="tc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="tc" target="lr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="re-call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="lenA" target="call"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="len" target="lenA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="native" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="lr" target="nat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="XML" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="lr" target="xml"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="nat" target="perm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="xml" target="perm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="deny" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="perm" target="den"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="allow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="perm" target="run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="den" target="pack"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="run" target="pack"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="pack" target="gev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="pack" target="fu"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="fu" target="res"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="no (or no tools)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="fu" target="end"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="end" target="pub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="lr" target="nt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="loopback" value="&lt;- page 2: driver loop re-enters here" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="1760" width="320" height="40" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="res" target="loopback"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="ex1" target="end"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="ex2" target="end"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2 Loop Drivers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="2000" pageHeight="1700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Who re-enters the turn?  Four drivers share ONE turn executor (and its _turn_lock)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="LA" value="A. Queue drain: user / voice / relay input  (_drain_queue :545)" style="swimlane;html=1;startSize=28;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="440" height="1500" as="geometry"/></mxCell><mxCell id="LB" value="B. Hub wake: peer msg / bg agent done  (message_handler.py:398)" style="swimlane;html=1;startSize=28;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="440" height="1500" as="geometry"/></mxCell><mxCell id="LC" value="C. Goal driver  (kollabor/goals/driver.py + service.maybe_continue)" style="swimlane;html=1;startSize=28;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="940" y="60" width="440" height="1500" as="geometry"/></mxCell><mxCell id="LD" value="D. Safety nets" style="swimlane;html=1;startSize=28;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1400" y="60" width="560" height="1500" as="geometry"/></mxCell><mxCell id="a1" value="enqueue(msg): drop-oldest / drop-newest / block on overflow&lt;br&gt;process_user_input skips drain if is_processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="LA"><mxGeometry x="30" y="50" width="380" height="60" as="geometry"/></mxCell><mxCell id="a2" value="LOOP 1: while queue non-empty&lt;br&gt;combine batch -&gt; process_message_batch&lt;br&gt;(adds user msg, _execute_llm_turn(user=True))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="LA"><mxGeometry x="30" y="140" width="380" height="80" as="geometry"/></mxCell><mxCell id="a3" value="LOOP 2: while NOT turn_completed and NOT cancelled" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="LA"><mxGeometry x="30" y="260" width="380" height="50" as="geometry"/></mxCell><mxCell id="a4" value="new msg in queue?&lt;br&gt;-&gt; break, LOOP 1 handles it as fresh turn&lt;br&gt;(pending tool results stay in history, next turn sees them)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="LA"><mxGeometry x="30" y="350" width="380" height="80" as="geometry"/></mxCell><mxCell id="a5" value="continue_conversation()&lt;br&gt;= _execute_llm_turn(user=False)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="LA"><mxGeometry x="30" y="470" width="380" height="60" as="geometry"/></mxCell><mxCell id="a6" value="Bounds: MAX_CONTINUATION_TURNS=500 -&gt; force stop&lt;br&gt;5-min checkpoint = log only, never kills&lt;br&gt;CIRCUIT BREAKER: 3 identical tool-error signatures -&gt; stop&lt;br&gt;turn error -&gt; stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="LA"><mxGeometry x="30" y="570" width="380" height="110" as="geometry"/></mxCell><mxCell id="a7" value="Exit: queue drained + not cancelled -&gt;&lt;br&gt;on_turn_settled() wakes yielded goals; force_ready() UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="LA"><mxGeometry x="30" y="720" width="380" height="70" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="none" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="a6" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="a3" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b1" value="TRIGGER_LLM_CONTINUE event&lt;br&gt;(hub bridge, agent_orchestrator injector, relay, remote task)&lt;br&gt;message already in history; &quot;to&quot; must match identity to fire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="LB"><mxGeometry x="30" y="50" width="380" height="90" as="geometry"/></mxCell><mxCell id="b2" value="pipe mode? -&gt; skip" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="LB"><mxGeometry x="30" y="170" width="380" height="40" as="geometry"/></mxCell><mxCell id="b3" value="blocked? cooldown 5s after ESC OR user typing&lt;br&gt;-&gt; _retry_continue task (coalesced), waits then re-fires&lt;br&gt;(a dropped wake once left agents mute forever)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="LB"><mxGeometry x="30" y="240" width="380" height="90" as="geometry"/></mxCell><mxCell id="b4" value="_hub_continue guards:&lt;br&gt;cancel flag -&gt; skip   is_processing -&gt; &quot;running turn sees it&quot;&lt;br&gt;else is_processing=True, turn_completed=False" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="LB"><mxGeometry x="30" y="370" width="380" height="90" as="geometry"/></mxCell><mxCell id="b5" value="drain pending agent HUD -&gt; inject once&lt;br&gt;await _continue_conversation()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="LB"><mxGeometry x="30" y="500" width="380" height="60" as="geometry"/></mxCell><mxCell id="b6" value="while NOT turn_completed and NOT cancelled:&lt;br&gt;queue non-empty -&gt; yield to drain&lt;br&gt;turn_count&gt;=500 -&gt; force stop&lt;br&gt;exception -&gt; break&lt;br&gt;(NO identical-error circuit breaker here)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="LB"><mxGeometry x="30" y="600" width="380" height="110" as="geometry"/></mxCell><mxCell id="b7" value="finally: is_processing=False;&lt;br&gt;relaunch process_queue if msgs piled up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="LB"><mxGeometry x="30" y="750" width="380" height="70" as="geometry"/></mxCell><mxCell id="b8" value="wait=&quot;true&quot; or auto-wait phrases (&quot;standing by&quot;, &quot;waiting for&quot;)&lt;br&gt;-&gt; end_turn metadata -&gt; chain stops (no ping-pong)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="LB"><mxGeometry x="30" y="860" width="380" height="70" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1" value="/goal create -&gt; schedule(goal_id) -&gt; _drive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="LC"><mxGeometry x="30" y="50" width="380" height="50" as="geometry"/></mxCell><mxCell id="c2" value="_run_one_turn(attempt): submit goal-origin turn on the SAME queue path&lt;br&gt;(goal_context block injected; one goal_report tool)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="LC"><mxGeometry x="30" y="130" width="380" height="80" as="geometry"/></mxCell><mxCell id="c3" value="TurnOutcome: ok / cancelled / error" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="LC"><mxGeometry x="30" y="250" width="380" height="40" as="geometry"/></mxCell><mxCell id="c4" value="maybe_continue boundary checklist:&lt;br&gt;clear/pause intents -&gt; stop   cancelled -&gt; pause   error -&gt; pause&lt;br&gt;origin!=goal -&gt; stop   user input queued / pending work / invalidated -&gt; yield&lt;br&gt;provider unhealthy -&gt; stop   hard bounds (turns/time) -&gt; stop&lt;br&gt;token budget admission (dispatch gate, never mid-turn kill)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="LC"><mxGeometry x="30" y="330" width="380" height="160" as="geometry"/></mxCell><mxCell id="c5" value="dispatch next attempt&lt;br&gt;(budget + bounds ok)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="LC"><mxGeometry x="30" y="520" width="380" height="50" as="geometry"/></mxCell><mxCell id="c6" value="yielded to user input -&gt; wake_yielded()&lt;br&gt;fires from qp.on_turn_settled (queue drained)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="LC"><mxGeometry x="30" y="610" width="380" height="60" as="geometry"/></mxCell><mxCell id="c7" value="on_tool_batch -&gt; runtime records goal_evidence rows;&lt;br&gt;model may only cite evidence runtime observed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="LC"><mxGeometry x="30" y="710" width="380" height="70" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="go" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="next" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c5" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="yield" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d1" value="turn_watchdog (slow cadence):&lt;br&gt;stuck_busy: is_processing + no progress &gt; threshold&lt;br&gt; AND no API call in flight AND no tool executing&lt;br&gt;-&gt; reset flags, close phantom turn, re-kick queue&lt;br&gt;orphaned_queue: idle + queue non-empty x2 checks -&gt; relaunch drain&lt;br&gt;never fires on: cancel pending, slow model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="LD"><mxGeometry x="30" y="50" width="500" height="150" as="geometry"/></mxCell><mxCell id="d3" value="ESC cancel: request_cancellation(origin)&lt;br&gt;cancel_processing latch; tool executor cancels in flight;&lt;br&gt;turn_completed=True; goals pause; hub wake honors a 5s cooldown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="LD"><mxGeometry x="30" y="230" width="500" height="90" as="geometry"/></mxCell><mxCell id="d4" value="_turn_lock: second caller WAITS (race between&lt;br&gt;_hub_continue and process_queue once interleaved turn counters 37,1,38,2)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="LD"><mxGeometry x="30" y="350" width="500" height="70" as="geometry"/></mxCell><mxCell id="d5" value="Pipe mode (-p): only the terminal response prints;&lt;br&gt;intermediate tool turns suppressed; TRIGGER_LLM_CONTINUE skipped" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="LD"><mxGeometry x="30" y="450" width="500" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3 Provider Loops"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="2000" pageHeight="2000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Provider layer: ONE shared agentic loop, providers only differ on the wire" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="h" value="conversation_history (internal ConversationMessage list)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="50" as="geometry"/></mxCell><mxCell id="g" value="NO SIZE TRIMMING (guard removed 2026-10-02)&lt;br&gt;request = whole history (no message-count slice either; both removed 10-02)&lt;br&gt;only leading orphan tool results / assistant turns dropped (API validity)&lt;br&gt;real overflow -&gt; loud error: model_context_window_exceeded -&gt; /compact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="420" height="110" as="geometry"/></mxCell><mxCell id="s" value="Provider serializes history (per-provider shape, table right)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="420" height="60" as="geometry"/></mxCell><mxCell id="r" value="Retry wrapper (api_communication_service.py:574-927)&lt;br&gt;5 attempts, 5s x 2^n backoff cap 120s + jitter&lt;br&gt;retry: 429, 5xx, transport, 408/409, empty response&lt;br&gt;NO retry: context overflow, 401, after visible stream output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="385" width="420" height="110" as="geometry"/></mxCell><mxCell id="x" value="Transport: SSE stream (default) or call()&lt;br&gt;ChatGPT/Codex: call() rerouted through a stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="420" height="70" as="geometry"/></mxCell><mxCell id="a" value="Accumulate: text deltas, tool_call deltas, thinking, usage, stop_reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="420" height="60" as="geometry"/></mxCell><mxCell id="o" value="Back to QueueProcessor:&lt;br&gt;has_pending_tool_calls() + last_stop_reason&lt;br&gt;Decision uses &quot;did a tool result come back&quot; (:1715)&lt;br&gt;stop_reason is only read for &quot;length&quot; auto-continue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="420" height="100" as="geometry"/></mxCell><mxCell id="c" value="Compaction between turns:&lt;br&gt;LLM_REQUEST_POST spawns bg summary,&lt;br&gt;next LLM_REQUEST_PRE swaps it in&lt;br&gt;trigger: API-reported prompt &gt;= 0.75 x window (cap 272K);&lt;br&gt;chars/3 estimate only if none reported (fixed 10-02)&lt;br&gt;(full flow: docs/diagrams/context-compaction.drawio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="330" height="130" as="geometry"/></mxCell><mxCell id="b" value="BYPASS the shared loop (no retry):&lt;br&gt;compaction summarizer, hub LLM helper, voice observer,&lt;br&gt;setup test, engine profile test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="520" y="270" width="300" height="100" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="h" target="g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="g" target="s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="s" target="r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="r" target="x"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="x" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="a" target="o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="c" target="g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pt" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#eee;text-align:left;width:170px&quot;&gt;Provider&lt;/th&gt;&lt;th style=&quot;background:#eee;text-align:left;width:200px&quot;&gt;Tool-call emit&lt;/th&gt;&lt;th style=&quot;background:#eee;text-align:left;width:240px&quot;&gt;Result fed back&lt;/th&gt;&lt;th style=&quot;background:#eee;text-align:left;width:260px&quot;&gt;Truncation continue (&quot;length&quot;)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;OpenAI chat / Azure / OpenRouter&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;native tool_calls deltas&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;role:&quot;tool&quot; + tool_call_id&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;works&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;Custom (OpenAI-compat)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;native tool_calls&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;role:&quot;tool&quot;&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;FIXED in tree 10-02: keeps last finish_reason&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;Anthropic (stream)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;tool_use blocks&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;user msg + tool_result block (adjacent users merged)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;FIXED in tree 10-02: max_tokens -&gt; length&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;OpenAI Responses&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;function_call items&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;function_call_output items&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;FIXED in tree 10-02: incomplete / max_output_tokens -&gt; length&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;ChatGPT / Codex (OAuth)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;same class as Responses: store=False, instructions always, previous_response_id ignored&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;same&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;FIXED in tree 10-02 (same class); OAuth token still refreshed only at provider (re)creation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;Gemini&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;native (unverified)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;NOT converted: role:&quot;tool&quot; never mapped&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;FIXED in tree 10-02: MAX_TOKENS -&gt; length; tool round trip unverified&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;XML mode (any provider)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;tags parsed from text&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;one batched user message&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;n/a&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;fillColor=#fff;strokeColor=#666;" vertex="1" parent="1"><mxGeometry x="520" y="420" width="920" height="330" as="geometry"/></mxCell><mxCell id="bg" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#eee;text-align:left;width:30px&quot;&gt;#&lt;/th&gt;&lt;th style=&quot;background:#eee;text-align:left;width:560px&quot;&gt;Bug (from code reading; not run live)&lt;/th&gt;&lt;th style=&quot;background:#eee;text-align:left;width:330px&quot;&gt;Where&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;1&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;FIXED in tree 10-02: Anthropic/Responses/Gemini stream &quot;length&quot; auto-continue&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;transformers.py:710-725&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;2&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;FIXED in tree 10-02: Custom provider finish_reason clobber + missing final chunk&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;custom_provider.py:~455&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;3&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;Gemini tool round trip unconverted (code-read only)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;gemini_provider.py:308-353&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;4&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;ChatGPT OAuth token never refreshed mid-session; 401 not retryable, long goals die&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;api_communication_service.py:444&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;5&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;REMOVED 10-02: question gate deleted (it ignored native tool calls)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;queue_processor.py&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;6&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;Hub-continue has no error circuit breaker; MAX_CONTINUATION_TURNS defined twice&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;message_handler.py:29,487&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;7&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;OpenAI/OpenRouter use stream index &quot;0&quot;,&quot;1&quot; as tool id (collides across turns)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;transformers.py:489&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;8&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;Tool call with empty args dropped (no-param Anthropic tools?)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;transformers.py:250,311&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;9&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;Responses stream skips response.failed/incomplete/error events&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;openai_responses_provider.py:1119&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;10&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;Responses/Gemini keep only the LAST system message&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;providers&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;12&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;Side loops (compaction, hub helper) have no 429/5xx retry&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;context_compaction_plugin.py:1544&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="520" y="780" width="960" height="420" as="geometry"/></mxCell><mxCell id="dd" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#eee;text-align:left;width:330px&quot;&gt;Orphaned / dead&lt;/th&gt;&lt;th style=&quot;background:#eee;text-align:left;width:590px&quot;&gt;Detail&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;force_continue&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;read at queue_processor.py:1990 but only ever set False (plugins/hub/plugin.py:8440)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;Responses previous_response_id / prompt_cache_* path&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;built, no caller&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;kollabor_ai/adapters/ + get_adapter_for_profile&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;no callers&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;LLMService._call_llm (llm_coordinator.py:2114)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;no callers&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;_format_tool_result (Responses, Gemini)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;no callers&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="1230" width="920" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4 Resume Vs Stop"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="When does the agent resume vs stop?  (turn_completed decides; every row has a source line)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="tr" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#eee;text-align:left;width:300px&quot;&gt;Trigger&lt;/th&gt;&lt;th style=&quot;background:#eee;text-align:left;width:360px&quot;&gt;Outcome&lt;/th&gt;&lt;th style=&quot;background:#eee;text-align:left;width:320px&quot;&gt;Where&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;Native tool calls in response&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;RESUME&lt;/b&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;queue_processor.py (native tools -&gt; turn_completed=False)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;XML/plugin tool results, any&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;RESUME&lt;/b&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;_tool_results_requiring_followup :86&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;Any tool FAILED (incl. permission denied)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;RESUME&lt;/b&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;failure blocks the end_turn release :97&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;LLM_RESPONSE hook force_continue&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;RESUME&lt;/b&gt; (wired, but NOTHING sets it True today)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;queue_processor.py:1301&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;stop_reason=length&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;RESUME inline&lt;/b&gt; (same turn, max 3, fragments deleted)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;queue_processor.py:1010&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;Peer message / bg agent finished&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;RESUME&lt;/b&gt; via TRIGGER_LLM_CONTINUE -&gt; _hub_continue&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;message_handler.py:398&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;Goal active and boundary checklist passes&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;RESUME&lt;/b&gt; as new goal attempt&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;goals/service.py:388&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;Watchdog heals stuck_busy / orphaned_queue&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;RESUME&lt;/b&gt; (queue relaunch)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;turn_watchdog.py:104&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1000" height="330" as="geometry"/></mxCell><mxCell id="ts" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#eee;text-align:left;width:300px&quot;&gt;Trigger&lt;/th&gt;&lt;th style=&quot;background:#eee;text-align:left;width:360px&quot;&gt;Outcome&lt;/th&gt;&lt;th style=&quot;background:#eee;text-align:left;width:320px&quot;&gt;Where&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;Text only, no tools&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;STOP&lt;/b&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;parser turn_completed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;All tools ok AND any metadata.end_turn (hub_msg wait=&quot;true&quot;, auto-wait phrases)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;STOP&lt;/b&gt; (results wait in history; reply starts next turn)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;queue_processor.py:97&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;Plugin turn_complete&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;STOP&lt;/b&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;queue_processor.py:1299&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;ESC cancel&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;STOP&lt;/b&gt; (goals pause, 5s hub cooldown)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;CancelledError handler :899&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;Unhandled exception&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;STOP&lt;/b&gt; + visible error + last_turn_error&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;:915&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;500 continuation turns&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;FORCE STOP&lt;/b&gt; (backstop)&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;MAX_CONTINUATION_TURNS :77&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;3 identical tool-error signatures&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;STOP&lt;/b&gt; in LOOP 2 only&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;queue_processor.py:659&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;New user message mid-chain&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;YIELD&lt;/b&gt; (not complete): LOOP 1 takes it; tool results stay in history&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;:624, message_handler.py:487&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot;&gt;Pipe-mode wake / cooldown / typing&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b&gt;DEFER or SKIP&lt;/b&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;message_handler.py:424-436&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1000" height="380" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>