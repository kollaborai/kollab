<mxfile host="drawio"><diagram id="full" name="Hub Wake Path"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1950" pageHeight="1750"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Hub Message Wake Path: Sender to Receiver Model Turn&lt;/b&gt;" style="text;html=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Every gate a message passes before the receiving agent runs a turn. Red = fixed this session. Orange = open gap. Grey = intentional stop." style="text;html=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1200" height="24" as="geometry"/></mxCell><mxCell id="c3" value="1. Sender agent (hub_msg tool)" style="swimlane;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="360" height="1620" as="geometry"/></mxCell><mxCell id="c4" value="2. Receiver relay tick (remote only)" style="swimlane;html=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="80" width="380" height="1620" as="geometry"/></mxCell><mxCell id="c5" value="3. Receiver hub plugin: _decide_hub_wake" style="swimlane;html=1;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="810" y="80" width="560" height="1620" as="geometry"/></mxCell><mxCell id="c6" value="4. Receiver LLM: TRIGGER_LLM_CONTINUE" style="swimlane;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1390" y="80" width="520" height="1620" as="geometry"/></mxCell><mxCell id="c7" value="Model emits &lt;b&gt;hub_msg&lt;/b&gt;&lt;br&gt;(XML tag or native tool)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="300" height="50" as="geometry"/></mxCell><mxCell id="c8" value="Validate target&lt;br&gt;self-target → coordinator, reject {template} syntax" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="300" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Auto-wait check&lt;/b&gt;&lt;br&gt;&amp;quot;standing by / waiting for / going quiet&amp;quot;&lt;br&gt;anywhere in text → wait=true&lt;br&gt;&lt;i&gt;GAP 3 open: long messages end the sender's turn&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="300" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Outgoing classification&lt;/b&gt; (metadata)&lt;br&gt;ack / task_report / task_assignment&lt;br&gt;&lt;i&gt;GAP 2 fixed: &amp;quot;incomplete&amp;quot;, &amp;quot;abandoned&amp;quot; read as reports&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="300" height="80" as="geometry"/></mxCell><mxCell id="c11" value="Target is relay: address?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="110" y="510" width="200" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Local mesh&lt;/b&gt;&lt;br&gt;unix socket / mailbox&lt;br&gt;(metadata carried)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="150" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Relay send gate&lt;/b&gt;&lt;br&gt;open/agents trust: no grant&lt;br&gt;manual: human grant + exact text" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="630" width="180" height="70" as="geometry"/></mxCell><mxCell id="c14" value="Send OK and wa